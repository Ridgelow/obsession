# Copy to mobile/.env — never commit .env (API keys stay local).

# Phase A Express. Physical phone: same public host as Custom LLM, no path:
#   https://snowboard-fact-separate-montana.trycloudflare.com
# Android emulator: http://10.0.2.2:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# Phase B — ElevenLabs. Agent id is waiting on Hasnain.
# API key may already be in your local .env — do not commit it.
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=
EXPO_PUBLIC_ELEVENLABS_API_KEY=

# ElevenLabs Agent dashboard → Custom LLM URL (not an env var).
# Cloudflared → :8787. Set this on the agent:
# https://snowboard-fact-separate-montana.trycloudflare.com/llm/chat/completions

# Phase B — Presage SmartSpectra camera HR. Get a key at
# https://physiology.presagetech.com  (never commit the real key)
EXPO_PUBLIC_PRESAGE_API_KEY=
# Set to 1 only after USE_FRAMEWORKS=dynamic prebuild + SmartSpectra SPM linked.
# Without that, leave unset — app uses the HR simulator.
EXPO_PUBLIC_PRESAGE_USE_NATIVE=

# Phase E — Persona 18+ (sandbox Inquiry Template, GovID + Selfie). Needs a
# **dev client**, not Expo Go. After npm i: npx expo prebuild --clean && npx expo run:ios --device
# Get the id from Persona Dashboard → Inquiries → Templates (starts with itmpl_).
EXPO_PUBLIC_PERSONA_TEMPLATE_ID=itmpl_YOUR_REAL_SANDBOX_TEMPLATE
EXPO_PUBLIC_PERSONA_USE_MOCK=0
