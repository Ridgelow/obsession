{
  "expo": {
    "name": "Obsession",
    "slug": "obsession",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0e0707"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.obsession.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Obsession uses the camera for Presage heart-rate sensing during practice dates.",
        "NSMicrophoneUsageDescription": "Obsession uses the microphone for voice practice dates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e0707",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.obsession.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@config-plugins/react-native-webrtc",
      "@livekit/react-native-expo-plugin",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      "./modules/smart-spectra/app.plugin.js"
    ]
  }
}
