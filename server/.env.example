# Gemini — https://ai.google.dev
GEMINI_API_KEY=

# Tiger Data (Tiger Cloud service — Postgres connection string)
# Create a service in Tiger Console, then paste its connection string here.
TIGER_DATA_URL=postgres://postgres:password@your-service.tigerdata.com:5432/postgres

# Backboard — https://docs.backboard.io
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

# Presage SmartSpectra (cloud Physiology API key, if using the REST path
# instead of the native iOS SDK — see mobile/services/presage notes)
PRESAGE_API_KEY=

# Persona — verification is mobile-SDK-driven; the server only needs this
# to confirm webhooked inquiry results server-side if you add that later
PERSONA_API_KEY=

PORT=8787
