# Copy to server/.env and fill. Never commit real secrets.

# Gemini — https://ai.google.dev  (model: gemini-2.5-flash)
GEMINI_API_KEY=

# Tiger Data / Tiger Cloud — Postgres connection string
# Create a service in Tiger Console, run server/db/schema.sql, paste the URL.
TIGER_DATA_URL=postgres://postgres:password@your-service.tigerdata.com:5432/tsdb?sslmode=require

# Backboard — https://docs.backboard.io
# Memories are assistant-scoped: reuse the same BACKBOARD_ASSISTANT_ID.
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
# Optional override (default: https://app.backboard.io/api)
# BACKBOARD_API_URL=https://app.backboard.io/api

# Presage SmartSpectra (optional — mobile simulator is the demo fallback)
PRESAGE_API_KEY=

# Persona — verification is mobile-SDK-driven; server key only if you
# later confirm inquiry webhooks server-side
PERSONA_API_KEY=

# ElevenLabs is configured in the Agent dashboard (Custom LLM URL),
# not as a server secret. Current tunnel (cloudflared → :8787):
#   https://origin-governments-vancouver-commitment.trycloudflare.com/llm/chat/completions
# Mobile: EXPO_PUBLIC_ELEVENLABS_AGENT_ID=agent_4801m2bbx00he4krmxrfdvyt4x2k
#         EXPO_PUBLIC_ELEVENLABS_API_KEY (local only — never commit)

# Hero-moment threshold: |HR − baseline| >= this → flagged + [SIGNAL]
NERVES_THRESHOLD_BPM=12

PORT=8787
